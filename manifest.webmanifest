  "orientation": "portrait-primary",
  "background_color": "#f5f8fa",
  "theme_color": "#005581",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nueva entrevista",
      "short_name": "Nueva",
      "url": "/index.html?view=booking",
      "icons": [{"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "Mis entrevistas",
      "short_name": "Solicitudes",
      "url": "/index.html?view=appointments",
      "icons": [{"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png"}]
    }
  ]
